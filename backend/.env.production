# Production Backend Environment Template
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ktnb_user
DB_PASSWORD=  # REQUIRED: Set a strong database password
DB_NAME=ktnb_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=  # REQUIRED: Generate with 'openssl rand -hex 32' (min 32 chars)
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGINS=https://happyworld.io.vn,https://www.happyworld.io.vn

# OLLAMA & Python OCR
OLLAMA_URL=http://localhost:11434
OCR_SERVICE_URL=http://127.0.0.1:8000/extract

# SSO (Optional)
SSO_ENABLED=false
SSO_API_KEY=
