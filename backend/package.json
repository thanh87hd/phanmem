{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:tsc": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "codegraph": "npm run graph:backend",
    "graph:backend": "node ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs src --config .dependency-cruiser.js --output-type html -f codegraph.html",
    "graph:backend:json": "node ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs src --config .dependency-cruiser.js --output-type json -f codegraph-backend.json",
    "graph:check": "node ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs src --config .dependency-cruiser.js",
    "prepare": "husky",
    "collab": "ts-node src/collaboration/server.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:show": "npm run typeorm migration:show",
    "check:hygiene": "node scripts/check-hygiene.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@bull-board/api": "^8.6.0",
    "@bull-board/fastify": "^8.6.0",
    "@casl/ability": "^7.0.0",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@firecrawl/pdf-inspector": "^1.12.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@types/ldapjs": "^3.0.6",
    "@types/uuid": "^10.0.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.7",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.6",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "ipaddr.js": "^2.5.0",
    "ldapjs": "^3.0.7",
    "mammoth": "^1.12.0",
    "mssql": "^12.5.5",
    "mysql2": "^3.22.4",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "systeminformation": "^5.33.1",
    "typeorm": "^0.3.29",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "y-websocket": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "CommonJS",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|otplib|@otplib|uuid|@noble)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  }
}
