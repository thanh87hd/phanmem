# ==============================================================================
# LPBANK SMART AUDIT 4.0 - PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# Lưu ý: Sao chép tệp này thành .env trong thư mục backend/ và điền các giá trị thực tế.
# Lệnh: cp deploy/.env.production.example backend/.env

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
BIND_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# Cảnh báo an ninh: Không dùng user 'postgres' hay mật khẩu mặc định trong Production.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=ktnb_user
DB_PASSWORD=ThayBangMatKhauPhucTapToiThieu16KyTu_Abc123!@#
DB_NAME=ktnb_db

# TypeORM đồng bộ schema (Trong production BẮT BUỘC để false, chạy migration qua script)
TYPEORM_SYNC=false

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT & CORS)
# ------------------------------------------------------------------------------
# Bắt buộc: JWT_SECRET phải có tối thiểu 32 ký tự ngẫu nhiên (backend sẽ kiểm tra lúc boot)
# Có thể sinh bằng lệnh: openssl rand -base64 48
JWT_SECRET=ThayBangChuoiKyTuNgauNhienToiThieu32KyTuDaiVaPhucTapNhat987654321
JWT_EXPIRES_IN=8h

# Danh sách Origins được phép gửi request đến API (phân tách bởi dấu phẩy)
# Ví dụ: https://chinhta.io.vn,https://audit.lpbank.com.vn
CORS_ORIGINS=https://chinhta.io.vn,http://localhost

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & JOB QUEUE (BULLMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=NeuCoMatKhauRedisThiDienVaoDay

# ------------------------------------------------------------------------------
# 5. INTEGRATIONS & MICROSERVICES
# ------------------------------------------------------------------------------
# Microservice Python OCR (Bóc tách văn bản scan PDF)
OCR_SERVICE_URL=http://127.0.0.1:8000/extract

# Kích hoạt tạo dữ liệu mẫu ban đầu (chỉ bật 1 lần khi khởi tạo DB lần đầu)
ENABLE_DEMO_SEED=false

# Giới hạn dung lượng tải tệp lên (bytes) - Mặc định 50MB
MAX_FILE_SIZE_BYTES=52428800
